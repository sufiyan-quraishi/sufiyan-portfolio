# Copy this file to .env and fill in your EmailJS credentials.
# See README.md "EmailJS Setup" section for step-by-step instructions.
# The app works fine without these set — the contact form will simply
# show a WhatsApp/Email fallback instead of the form.

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
